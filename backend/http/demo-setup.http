### Bracket
POST {{host}}/api/tournaments/{{dTid}}/bracket
Authorization: Bearer {{dTO}}

> {%
    client.global.set("dPf1", response.body.rounds[0].matches[0].id);
    client.global.set("dPf2", response.body.rounds[0].matches[1].id);
    client.global.set("dFin", response.body.rounds[1].matches[0].id);
%}

### Sudija na sva 3 meca
PUT {{host}}/api/matches/{{dPf1}}/referee
Content-Type: application/json
Authorization: Bearer {{dTO}}

{ "username": "{{dRef}}" }

###
PUT {{host}}/api/matches/{{dPf2}}/referee
Content-Type: application/json
Authorization: Bearer {{dTO}}

{ "username": "{{dRef}}" }

###
PUT {{host}}/api/matches/{{dFin}}/referee
Content-Type: application/json
Authorization: Bearer {{dTO}}

{ "username": "{{dRef}}" }

> {%
    client.log("================================================");
    client.log("OTVORI U BROWSERU:");
    client.log("http://localhost:8080/spectator.html?t=" + client.global.get("dTid"));
    client.log("pa pokreci demo-play.http korak po korak (klik na > pored svakog)");
    client.log("================================================");
%}
