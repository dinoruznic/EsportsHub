### EsportsHub — Live mec (state machine + sudija + prolazak pobjednika + event log)
### Run all (⏩). Odigra cijeli turnir od 4 tima: polufinala -> finale -> COMPLETED.
### Seeding: team1..team4 prijavljeni redom -> PF1 = team1 vs team4, PF2 = team2 vs team3.

@host = http://localhost:8080

### 0. Igre + identiteti
GET {{host}}/api/games

> {%
    var r = Math.floor(Math.random() * 1000000);
    client.global.set("org", "org" + r);
    client.global.set("ref", "ref" + r);
    for (var i = 1; i <= 4; i++) {
        client.global.set("cap" + i, "cap" + i + "m" + r);
        client.global.set("tag" + i, String.fromCharCode(64 + i) + (r % 1000));
    }
    response.body.forEach(function (g) { if (g.code === "LOL") client.global.set("lolId", g.id); });
%}

### 1. Admin login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "usernameOrEmail": "admin", "password": "admin12345" }

> {% client.global.set("tA", response.body.token); %}

### 2. Organizator register
POST {{host}}/api/auth/register
Content-Type: application/json

{ "username": "{{org}}", "email": "{{org}}@esportshub.local", "password": "lozinka123", "displayName": "Org" }

### 3. Organizator login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "usernameOrEmail": "{{org}}", "password": "lozinka123" }

> {% client.global.set("tO", response.body.token); %}

### 4. Sudija register
POST {{host}}/api/auth/register
Content-Type: application/json

{ "username": "{{ref}}", "email": "{{ref}}@esportshub.local", "password": "lozinka123", "displayName": "Sudija" }

### 5. Sudija login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "usernameOrEmail": "{{ref}}", "password": "lozinka123" }

> {% client.global.set("tR", response.body.token); %}

### 6. Organizator (nije admin) pokusa dodijeliti ulogu -> 403
POST {{host}}/api/admin/users/{{ref}}/roles
Content-Type: application/json
Authorization: Bearer {{tO}}

{ "role": "REFEREE" }

> {% client.test("ne-admin dodjela uloge 403", function(){ client.assert(response.status===403); }); %}

### 7. Admin dodijeli nepostojecu ulogu -> 400
POST {{host}}/api/admin/users/{{ref}}/roles
Content-Type: application/json
Authorization: Bearer {{tA}}

{ "role": "KRALJ" }

> {% client.test("nepostojeca uloga 400", function(){ client.assert(response.status===400); }); %}

### 8. Admin dodijeli REFEREE -> 200 (sad ima PLAYER + REFEREE)
POST {{host}}/api/admin/users/{{ref}}/roles
Content-Type: application/json
Authorization: Bearer {{tA}}

{ "role": "REFEREE" }

> {%
    client.test("dodjela 200", function(){ client.assert(response.status===200); });
    client.test("vise uloga (user_roles fix)", function(){ client.assert(JSON.stringify(response.body).indexOf("REFEREE") >= 0 && JSON.stringify(response.body).indexOf("PLAYER") >= 0); });
%}

### 9. Turnir (4 tima)
POST {{host}}/api/tournaments
Content-Type: application/json
Authorization: Bearer {{tO}}

{ "name": "Live Kup {{org}}", "gameId": {{lolId}}, "format": "SINGLE_ELIMINATION", "maxTeams": 4 }

> {% client.global.set("tid", response.body.id); %}

### 10. Admin odobri
POST {{host}}/api/tournaments/{{tid}}/approve
Authorization: Bearer {{tA}}

### ---------- 4 kapitena: register, login, tim, prijava ----------
