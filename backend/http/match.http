### ---------- BRACKET ----------
### 27. Organizator generise bracket -> pf1, pf2, final
POST {{host}}/api/tournaments/{{tid}}/bracket
Authorization: Bearer {{tO}}

> {%
    client.test("bracket 201", function(){ client.assert(response.status===201); });
    client.global.set("pf1", response.body.rounds[0].matches[0].id);
    client.global.set("pf2", response.body.rounds[0].matches[1].id);
    client.global.set("fin", response.body.rounds[1].matches[0].id);
%}

### ---------- SUDIJA ----------
### 28. Dodijeli sudiju korisniku koji NIJE sudija (cap1) -> 400
PUT {{host}}/api/matches/{{pf1}}/referee
Content-Type: application/json
Authorization: Bearer {{tO}}

{ "username": "{{cap1}}" }

> {% client.test("nije sudija 400", function(){ client.assert(response.status===400); }); %}

### 29. Kapiten pokusa dodijeliti sudiju -> 403
PUT {{host}}/api/matches/{{pf1}}/referee
Content-Type: application/json
Authorization: Bearer {{t1}}

{ "username": "{{ref}}" }

> {% client.test("kapiten dodjela sudije 403", function(){ client.assert(response.status===403); }); %}

### 30. Organizator dodijeli sudiju PF1
PUT {{host}}/api/matches/{{pf1}}/referee
Content-Type: application/json
Authorization: Bearer {{tO}}

{ "username": "{{ref}}" }

> {% client.test("sudija PF1 200", function(){ client.assert(response.status===200); }); %}

### 31. Organizator dodijeli sudiju PF2
PUT {{host}}/api/matches/{{pf2}}/referee
Content-Type: application/json
Authorization: Bearer {{tO}}

{ "username": "{{ref}}" }

### 32. Organizator dodijeli sudiju FINALU
PUT {{host}}/api/matches/{{fin}}/referee
Content-Type: application/json
Authorization: Bearer {{tO}}

{ "username": "{{ref}}" }

### ---------- STATE MACHINE: zabranjeni prelazi ----------
### 33. Rezultat prije starta -> 409
PUT {{host}}/api/matches/{{pf1}}/score
Content-Type: application/json
Authorization: Bearer {{tR}}

{ "scoreA": 1, "scoreB": 0 }

> {% client.test("score prije starta 409", function(){ client.assert(response.status===409); }); %}

### 34. SCHEDULED -> FINISHED direktno -> 409
POST {{host}}/api/matches/{{pf1}}/finish
Content-Type: application/json
Authorization: Bearer {{tR}}

{ "scoreA": 2, "scoreB": 0 }

> {% client.test("SCHEDULED->FINISHED 409", function(){ client.assert(response.status===409); }); %}

### 35. Kapiten pokusa startovati -> 403
POST {{host}}/api/matches/{{pf1}}/start
Authorization: Bearer {{t1}}

> {% client.test("kapiten start 403", function(){ client.assert(response.status===403); }); %}

### 36. Finale bez timova -> start 409
POST {{host}}/api/matches/{{fin}}/start
Authorization: Bearer {{tR}}

> {% client.test("finale bez timova 409", function(){ client.assert(response.status===409); }); %}

### ---------- POLUFINALE 1 ----------
### 37. Sudija startuje PF1 -> LIVE
POST {{host}}/api/matches/{{pf1}}/start
Authorization: Bearer {{tR}}

> {% client.test("PF1 LIVE", function(){ client.assert(response.body.status==="LIVE"); }); %}

### 38. Start opet (LIVE -> LIVE) -> 409
POST {{host}}/api/matches/{{pf1}}/start
Authorization: Bearer {{tR}}

> {% client.test("LIVE->LIVE 409", function(){ client.assert(response.status===409); }); %}

### 39. Uzivo rezultat 1:0
PUT {{host}}/api/matches/{{pf1}}/score
Content-Type: application/json
Authorization: Bearer {{tR}}

{ "scoreA": 1, "scoreB": 0 }

> {% client.test("score 1:0", function(){ client.assert(response.body.scoreA===1 && response.body.scoreB===0); }); %}

### 40. Nerijeseno -> 400
POST {{host}}/api/matches/{{pf1}}/finish
Content-Type: application/json
Authorization: Bearer {{tR}}

{ "scoreA": 1, "scoreB": 1 }

> {% client.test("nerijeseno 400", function(){ client.assert(response.status===400); }); %}

### 41. Kraj PF1 2:1 -> pobjednik team1
POST {{host}}/api/matches/{{pf1}}/finish
Content-Type: application/json
Authorization: Bearer {{tR}}

{ "scoreA": 2, "scoreB": 1 }

> {%
    client.test("PF1 FINISHED", function(){ client.assert(response.body.status==="FINISHED"); });
    client.test("pobjednik team1", function(){ client.assert(response.body.winnerTeamId === client.global.get("team1")); });
%}

### ---------- POLUFINALE 2 ----------
### 42. Start PF2
POST {{host}}/api/matches/{{pf2}}/start
Authorization: Bearer {{tR}}

### 43. Kraj PF2 0:2 -> pobjednik team3 (tim B)
POST {{host}}/api/matches/{{pf2}}/finish
Content-Type: application/json
Authorization: Bearer {{tR}}

{ "scoreA": 0, "scoreB": 2 }

> {% client.test("pobjednik team3", function(){ client.assert(response.body.winnerTeamId === client.global.get("team3")); }); %}

### ---------- FINALE ----------
### 44. Finale sad ima team1 (A) i team3 (B)
GET {{host}}/api/matches/{{fin}}

> {%
    client.test("finale A = team1", function(){ client.assert(response.body.teamA.id === client.global.get("team1")); });
    client.test("finale B = team3", function(){ client.assert(response.body.teamB.id === client.global.get("team3")); });
%}

### 45. Start finala
POST {{host}}/api/matches/{{fin}}/start
Authorization: Bearer {{tR}}

> {% client.test("finale LIVE", function(){ client.assert(response.body.status==="LIVE"); }); %}

### 46. Kraj finala 3:1 -> team1 prvak
POST {{host}}/api/matches/{{fin}}/finish
Content-Type: application/json
Authorization: Bearer {{tR}}

{ "scoreA": 3, "scoreB": 1 }

> {% client.test("prvak team1", function(){ client.assert(response.body.winnerTeamId === client.global.get("team1")); }); %}

### 47. Turnir -> COMPLETED
GET {{host}}/api/tournaments/{{tid}}

> {% client.test("turnir COMPLETED", function(){ client.assert(response.body.status==="COMPLETED"); }); %}

### ---------- EVENT LOG (Observer) ----------
### 48. Event log PF1 (bez tokena)
GET {{host}}/api/matches/{{pf1}}/events

> {%
    var s = JSON.stringify(response.body);
    client.test("events 200", function(){ client.assert(response.status===200); });
    client.test("ima STARTED", function(){ client.assert(s.indexOf("STARTED") >= 0); });
    client.test("ima SCORE_UPDATED", function(){ client.assert(s.indexOf("SCORE_UPDATED") >= 0); });
    client.test("ima FINISHED", function(){ client.assert(s.indexOf("FINISHED") >= 0); });
    client.test("ima WINNER_ADVANCED", function(){ client.assert(s.indexOf("WINNER_ADVANCED") >= 0); });
%}

### 49. Event log finala -> TOURNAMENT_COMPLETED
GET {{host}}/api/matches/{{fin}}/events

> {% client.test("ima TOURNAMENT_COMPLETED", function(){ client.assert(JSON.stringify(response.body).indexOf("TOURNAMENT_COMPLETED") >= 0); }); %}
