### EsportsHub — Bracket (Strategy + Builder)
### Run all (⏩). Organizator pravi turnir, admin odobri, 4 kapitena prijave timove, generise se bracket.

@host = http://localhost:8080

### 0. Igre + identiteti
GET {{host}}/api/games

> {%
    var r = Math.floor(Math.random() * 1000000);
    client.global.set("org", "org" + r);
    for (var i = 1; i <= 4; i++) {
        client.global.set("cap" + i, "cap" + i + "x" + r);
        client.global.set("tag" + i, String.fromCharCode(64 + i) + (r % 1000));
    }
    response.body.forEach(function (g) { if (g.code === "LOL") client.global.set("lolId", g.id); });
%}

### 1. Organizator register
POST {{host}}/api/auth/register
Content-Type: application/json

{ "username": "{{org}}", "email": "{{org}}@esportshub.local", "password": "lozinka123", "displayName": "Org" }

### 2. Organizator login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "usernameOrEmail": "{{org}}", "password": "lozinka123" }

> {% client.global.set("tokenO", response.body.token); %}

### 3. Turnir (4 tima, single elimination)
POST {{host}}/api/tournaments
Content-Type: application/json
Authorization: Bearer {{tokenO}}

{ "name": "Bracket Kup {{org}}", "gameId": {{lolId}}, "format": "SINGLE_ELIMINATION", "maxTeams": 4 }

> {% client.global.set("tid", response.body.id); %}

### 4. Admin login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "usernameOrEmail": "admin", "password": "admin12345" }

> {% client.global.set("tokenA", response.body.token); %}

### 5. Admin odobri -> REGISTRATION
POST {{host}}/api/tournaments/{{tid}}/approve
Authorization: Bearer {{tokenA}}

> {% client.test("REGISTRATION", function(){ client.assert(response.body.status==="REGISTRATION"); }); %}

