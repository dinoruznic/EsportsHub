### ---------- BRACKET ----------
### 22. Kapiten pokusa generisati -> 403 (samo organizator/admin)
POST {{host}}/api/tournaments/{{tid}}/bracket
Authorization: Bearer {{t1}}

> {% client.test("kapiten 403", function(){ client.assert(response.status===403); }); %}

### 23. Organizator generise bracket -> 201
POST {{host}}/api/tournaments/{{tid}}/bracket
Authorization: Bearer {{tokenO}}

> {%
    client.test("generisanje 201", function(){ client.assert(response.status===201); });
    client.test("turnir ONGOING", function(){ client.assert(response.body.status==="ONGOING"); });
    var rounds = response.body.rounds;
    client.test("2 runde", function(){ client.assert(rounds.length === 2); });
    client.test("runda 1 = Polufinale", function(){ client.assert(rounds[0].name === "Polufinale"); });
    client.test("runda 2 = Finale", function(){ client.assert(rounds[1].name === "Finale"); });
    var sf = rounds[0].matches, fin = rounds[1].matches[0];
    client.test("2 polufinala", function(){ client.assert(sf.length === 2); });
    client.test("seeding: seed1 vs seed4", function(){
        client.assert(sf[0].teamA.id === client.global.get("team1") && sf[0].teamB.id === client.global.get("team4"));
    });
    client.test("seeding: seed2 vs seed3", function(){
        client.assert(sf[1].teamA.id === client.global.get("team2") && sf[1].teamB.id === client.global.get("team3"));
    });
    client.test("finale je prazno", function(){ client.assert(fin.teamA === null && fin.teamB === null); });
    client.test("oba polufinala vode u finale", function(){
        client.assert(sf[0].nextMatchId === fin.id && sf[1].nextMatchId === fin.id);
    });
    client.test("spectatorKey postoji", function(){ client.assert(sf[0].spectatorKey && sf[0].spectatorKey.length > 0); });
%}

### 24. Generisi opet -> 409 (bracket vec postoji)
POST {{host}}/api/tournaments/{{tid}}/bracket
Authorization: Bearer {{tokenO}}

> {% client.test("drugo generisanje 409", function(){ client.assert(response.status===409); }); %}

### 25. Javni pregled bracketa (bez tokena) -> 200
GET {{host}}/api/tournaments/{{tid}}/bracket

> {%
    client.test("pregled 200", function(){ client.assert(response.status===200); });
    client.test("2 runde u pregledu", function(){ client.assert(response.body.rounds.length === 2); });
%}

### 26. Prijava nakon zdrijeba -> 409 (turnir vise nije u fazi prijava)
POST {{host}}/api/tournaments/{{tid}}/registrations
Content-Type: application/json
Authorization: Bearer {{t1}}

{ "teamId": {{team1}} }

> {% client.test("prijava nakon zdrijeba 409", function(){ client.assert(response.status===409); }); %}
